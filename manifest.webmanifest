      "label": "Menu Card Catalogue — desktop view"
    },
    {
      "src": "./screenshots/screenshot-narrow.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Menu Card Catalogue — mobile view"
    }
  ]
